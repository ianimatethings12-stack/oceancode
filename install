#!/usr/bin/env sh
set -eu

REPO="ianimatethings12-stack/oceancode"
PACKAGE="oceancode"
VERSION="${VERSION:-}"

fail() {
  printf 'error: %s\n' "$1" >&2
  exit 1
}

command -v curl >/dev/null 2>&1 || fail "curl is required"
command -v tar >/dev/null 2>&1 || fail "tar is required"

os="$(uname -s | tr '[:upper:]' '[:lower:]')"
case "$os" in
  darwin) os="darwin" ;;
  linux) os="linux" ;;
  mingw*|msys*|cygwin*) os="windows" ;;
  *) fail "unsupported operating system: $os" ;;
esac

arch="$(uname -m)"
case "$arch" in
  x86_64|amd64) arch="x64" ;;
  arm64|aarch64) arch="arm64" ;;
  *) fail "unsupported architecture: $arch" ;;
esac

if [ -z "$VERSION" ]; then
  VERSION="$(curl -fsSL "https://api.github.com/repos/${REPO}/releases/latest" |
    sed -n 's/.*"tag_name"[[:space:]]*:[[:space:]]*"v\{0,1\}\([^"]*\)".*/\1/p' |
    head -n 1)"
fi
[ -n "$VERSION" ] || fail "could not determine the latest version; set VERSION explicitly"

target="${PACKAGE}-${os}-${arch}"
url="https://registry.npmjs.org/${target}/-/${target}-${VERSION}.tgz"

workdir="$(mktemp -d 2>/dev/null || mktemp -d -t oceancode)"
trap 'rm -rf "$workdir"' EXIT INT TERM
archive="$workdir/package.tgz"

printf 'Downloading OceanCode %s for %s-%s...\n' "$VERSION" "$os" "$arch"
curl -fsSL "$url" -o "$archive" || fail "could not download $url"
tar -xzf "$archive" -C "$workdir" || fail "could not unpack $url"

binary="$workdir/package/bin/oceancode"
[ -f "$binary" ] || binary="$workdir/package/bin/oceancode.exe"
[ -f "$binary" ] || fail "downloaded package does not contain an oceancode binary"

if [ -n "${OCEANCODE_INSTALL_DIR:-}" ]; then
  install_dir="$OCEANCODE_INSTALL_DIR"
elif [ -n "${XDG_BIN_DIR:-}" ]; then
  install_dir="$XDG_BIN_DIR"
elif [ -d "$HOME/bin" ] || mkdir -p "$HOME/bin" 2>/dev/null; then
  install_dir="$HOME/bin"
else
  install_dir="$HOME/.oceancode/bin"
fi

mkdir -p "$install_dir"
dest="$install_dir/oceancode"
cp "$binary" "$dest"
chmod 755 "$dest"

marker="# OceanCode"
for profile in "$HOME/.bashrc" "$HOME/.zshrc" "$HOME/.profile"; do
  [ -f "$profile" ] || continue
  grep -q "OCEANCODE_INSTALL_DIR" "$profile" 2>/dev/null && continue
  {
    printf '\n%s\n' "$marker"
    printf 'export PATH="%s:$PATH"\n' "$install_dir"
  } >>"$profile"
done

printf 'Installed OceanCode to %s\n' "$dest"
"$dest" --version
